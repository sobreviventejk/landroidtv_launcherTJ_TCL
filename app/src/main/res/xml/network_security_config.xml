<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Every remote resource of the launcher (weather, wallpapers, updates) is HTTPS.
         Cleartext is blocked so no image or file can be silently modified on the network. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
