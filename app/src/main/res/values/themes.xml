<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Black by default, independent of the wallpaper. -->
    <style name="Theme.TVLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:colorBackground">@color/bg_main</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="Theme.TVLauncher.AboutDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@color/dialog_bg</item>
        <item name="android:colorBackground">@color/dialog_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/accent</item>
        <!-- Keeps the dialogs narrow and centered on TV instead of stretching edge to edge. -->
        <item name="android:windowMinWidthMajor">42%</item>
        <item name="android:windowMinWidthMinor">42%</item>
        <item name="android:backgroundDimAmount">0.72</item>
    </style>
</resources>
