<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/weather_v42_dialog_background"
    android:orientation="vertical"
    android:paddingStart="26dp"
    android:paddingTop="22dp"
    android:paddingEnd="26dp"
    android:paddingBottom="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/weather_v42_title"
                android:textColor="#FFFFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/weather_v42_location"
                android:textColor="#99FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/weatherV42RefreshProgress"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            android:indeterminate="true"
            android:indeterminateTint="#FF93C5FD"
            android:visibility="gone" />

        <Button
            android:id="@+id/weatherV42Refresh"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/weather_v42_refresh_background"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="126dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:stateListAnimator="@null"
            android:text="@string/weather_v42_refresh"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weatherV42CurrentSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/weather_v42_current_background"
        android:gravity="center_vertical"
        android:minHeight="112dp"
        android:orientation="horizontal"
        android:padding="20dp">

        <ImageView
            android:id="@+id/weatherV42CurrentIcon"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/weather_v42_current_label"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/weatherV42CurrentTemperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="43sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/weatherV42CurrentCondition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#E6FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/weatherV42DaysTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="9dp"
        android:text="@string/weather_v42_days_title"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/weatherV42Status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:padding="24dp"
        android:text="@string/weather_v42_loading"
        android:textColor="#B3FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/weatherV42DaysScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:paddingBottom="4dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/weatherV42DaysContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
